NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bank_sampah?schema=public

# Wajib diisi sendiri (minimal 32 karakter acak), tidak ada nilai default di kode
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Pisahkan dengan koma jika lebih dari satu origin
CORS_ORIGINS=http://localhost:5173
BCRYPT_ROUNDS=10
RESET_TOKEN_TTL_MINUTES=30
